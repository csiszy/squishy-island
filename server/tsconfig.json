{
  // Nakama runs one plain JavaScript file (build/index.js) with global functions: no modules, old-style JavaScript.
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "es2015.core"],
    "outFile": "./build/index.js",
    "strict": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "typeRoots": []
  },
  "files": ["src/nakama.d.ts", "src/data.generated.ts", "src/rules.ts", "src/main.ts"]
}
